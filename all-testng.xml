<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AllTestsSuite" verbose="2" parallel="none">
  <listeners>
    <listener class-name="base.TestNGInitListener"/>
    <listener class-name="utils.CustomHtmlReporter"/>
  </listeners>
  <test name="AllTests" preserve-order="true">
    <!-- No group filter — runs every @Test in the testing package -->
    <packages>
      <package name="testing"/>
    </packages>
  </test>
</suite>
