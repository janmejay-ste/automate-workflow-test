<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SmokeTestSuite" verbose="2" parallel="none">
  <listeners>
    <listener class-name="base.TestNGInitListener"/>
    <listener class-name="utils.CustomHtmlReporter"/>
  </listeners>
  <test name="SmokeTests" preserve-order="true">
    <groups><run><include name="smoke"/></run></groups>
    <packages><package name="testing"/></packages>
  </test>
</suite>
